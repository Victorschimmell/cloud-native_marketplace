'  cancelled_at : timestamp
'  refund_status : text
'}

'entity "refund" as refund {
'  * refund_id : uuid <<PK>>
'  --
'  cancellation_id : uuid <<FK>>
'  order_id : uuid <<FK>>
'  amount : numeric
'  refund_status : text
'  external_refund_reference : text <<nullable>>
'  processed_at : timestamp <<nullable>>
'}

' =========================
' ADMIN / MONITORING
' =========================

entity "number_sequence" as number_sequence #DCEEFF {
  * sequence_id : uuid <<PK>>
  --
  sequence_key : varchar(100) <<UQ>>
  last_value : bigint
}

entity "admin_issue" as admin_issue #DCEEFF {
  * issue_id : uuid <<PK>>
  --
  title : varchar(200)
  description : varchar(4000)
  type : integer
  priority : integer <<indexed>>
  status : integer <<indexed>>
  reported_by_user_id : uuid <<FK, indexed>>
  assigned_to_user_id : uuid <<FK, nullable>>
  resolved_by_user_id : uuid <<FK, nullable>>
  resolved_at : timestamptz <<nullable>>
  resolution : varchar(4000) <<nullable>>
  created_at : timestamptz
  updated_at : timestamptz
}

entity "audit_log" as audit_log #DCEEFF {
  * audit_log_id : uuid <<PK>>
  --
  actor_user_id : uuid <<FK, nullable>>
  actor_ip_address : varchar(45) <<nullable>>
  action_type : integer
  target_entity_type : varchar(200)
  target_entity_id : varchar(200)
  outcome : integer
  details : text
  created_at : timestamptz
}

' =========================
' RELATIONSHIPS
' =========================

user_account ||--o| customer : has
user_account ||--o| seller : has
user_account ||--o{ user_session : starts

seller ||--o{ seller_verification_request : submits
user_account ||--o{ seller_verification_request : reviews

address ||--o{ customer : default_address
address ||--o{ seller : default_address

product_category ||--o{ product : classifies
product ||--o{ product_listing : listed_as
seller ||--o{ product_listing : owns

user_account ||--o{ shopping_cart : owns
user_session ||--o{ shopping_cart : guest_session
shopping_cart ||--o{ cart_item : contains
shopping_cart ||--o{ shopping_cart : recovers
product_listing ||--o{ cart_item : referenced_by

customer ||--o{ order : places
address ||--o{ order : ship_to
shopping_cart ||--o{ order : converts_to

order ||--o{ order_item : contains
product_listing ||--o{ order_item : sold_as
product ||--o{ order_item : snapshot_product
seller ||--o{ order_item : fulfilled_by

currency ||--o{ order_payment : denominates
order ||--o{ order_payment : paid_by
order ||--o{ order_review : reviewed_by
order_item ||--o{ order_review : reviewed_item
customer ||--o{ order_review : writes
product ||--o{ order_review : receives
order ||--o{ shipment : shipped_in
seller ||--o{ shipment : ships

'order ||--o| order_cancellation : may_have
'order_cancellation ||--o{ refund : triggers

user_account ||--o{ audit_log : acts_in
user_account ||--o{ admin_issue : reports
user_account ||--o{ admin_issue : assigned_to
user_account ||--o{ admin_issue : resolves

@enduml
