@startuml

hide circle
skinparam linetype ortho
skinparam shadowing false

' =========================
' IDENTITY / ACCESS
' =========================

entity "user_accounts" as user_accounts {
  * user_id : uuid <<PK>>
  --
  email : text <<UQ>>
  password_hash : text
  role : text
  account_status : text
  failed_login_attempts : int
  locked_until : timestamp
  created_at : timestamp
  updated_at : timestamp
  last_login_at : timestamp
}

entity "customers" as customers {
  * customer_id : uuid <<PK>>
  --
  user_id : uuid <<FK, UQ>>
  first_name : text
  last_name : text
  phone : text
  default_address_id : uuid <<FK, nullable>>
  olist_customer_id : text <<UQ, nullable>>
  olist_customer_unique_id : text <<nullable>>
  created_at : timestamp
}

entity "sellers" as sellers {
  * seller_id : uuid <<PK>>
  --
  user_id : uuid <<FK, UQ>>
  business_name : text
  registration_number : text
  payout_information : text
  default_address_id : uuid <<FK, nullable>>
  verification_status : text
  verified_at : timestamp <<nullable>>
  olist_seller_id : text <<UQ, nullable>>
  created_at : timestamp
}

entity "admins" as admins {
  * admin_id : uuid <<PK>>
  --
  user_id : uuid <<FK, UQ>>
  display_name : text
  created_at : timestamp
}

entity "user_sessions" as user_sessions {
  * session_id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  ip_address : inet
  user_agent : text
  started_at : timestamp
  expires_at : timestamp
  ended_at : timestamp <<nullable>>
  is_active : boolean
}

entity "user_blocks" as user_blocks {
  * block_id : uuid <<PK>>
  --
  user_id : uuid <<FK, nullable>>
  ip_address : inet <<nullable>>
  blocked_by_admin_id : uuid <<FK>>
  reason : text
  starts_at : timestamp
  ends_at : timestamp
  is_active : boolean
  created_at : timestamp
}

entity "seller_verification_requests" as seller_verification_requests {
  * verification_request_id : uuid <<PK>>
  --
  seller_id : uuid <<FK>>
  submitted_at : timestamp
  status : text
  business_name_snapshot : text
  registration_number_snapshot : text
  submitted_details : text
  review_notes : text <<nullable>>
  reviewed_by_admin_id : uuid <<FK, nullable>>
  reviewed_at : timestamp <<nullable>>
  rejection_reason : text <<nullable>>
}

' =========================
' LOCATION
' =========================

entity "addresses" as addresses {
  * address_id : uuid <<PK>>
  --
  postal_code : text
  city : text
  state : text
  address_line_1 : text <<nullable>>
  address_line_2 : text <<nullable>>
  country_code : text
  latitude : numeric <<nullable>>
  longitude : numeric <<nullable>>
  created_at : timestamp
}

entity "geolocations" as geolocations {
  geolocation_zip_code_prefix : int
  geolocation_lat : numeric
  geolocation_lng : numeric
  geolocation_city : text
  geolocation_state : text
}

' =========================
' CATALOG / SELLING
' =========================

entity "product_categories" as product_categories {
  * category_id : uuid <<PK>>
  --
  category_name_pt : text <<UQ>>
  category_name_en : text <<nullable>>
}

entity "products" as products {
  * product_id : uuid <<PK>>
  --
  category_id : uuid <<FK>>
  product_name : text
  description : text
  product_name_length : int
  product_description_length : int
  product_photos_qty : int
  product_weight_g : int
  product_length_cm : int
  product_height_cm : int
  product_width_cm : int
  created_at : timestamp
  updated_at : timestamp
  olist_product_id : text <<UQ, nullable>>
}

entity "product_listings" as product_listings {
  * listing_id : uuid <<PK>>
  --
  seller_id : uuid <<FK>>
  product_id : uuid <<FK>>
  sku : text
  listing_price : numeric
  inventory_quantity : int
  visibility_status : text
  is_deleted : boolean
  published_at : timestamp <<nullable>>
  created_at : timestamp
  updated_at : timestamp
}

' =========================
' CART / CHECKOUT
' =========================

entity "shopping_carts" as shopping_carts {
  * cart_id : uuid <<PK>>
  --
  user_id : uuid <<FK, nullable>>
  session_id : uuid <<FK, nullable>>
  status : text
  created_at : timestamp
  updated_at : timestamp
  expires_at : timestamp
  recovered_from_cart_id : uuid <<FK, nullable>>
}

entity "cart_items" as cart_items {
  * cart_item_id : uuid <<PK>>
  --
  cart_id : uuid <<FK>>
  listing_id : uuid <<FK>>
  quantity : int
  unit_price_at_addition : numeric
  added_at : timestamp
  updated_at : timestamp
}

' =========================
' ORDERS
' =========================

entity "orders" as orders {
  * order_id : uuid <<PK>>
  --
  customer_id : uuid <<FK>>
  shipping_address_id : uuid <<FK>>
  order_status : text
  order_purchase_timestamp : timestamp
  order_approved_at : timestamp <<nullable>>
  order_delivered_carrier_date : timestamp <<nullable>>
  order_delivered_customer_date : timestamp <<nullable>>
  order_estimated_delivery_date : timestamp <<nullable>>
  subtotal_amount : numeric
  freight_amount : numeric
  total_amount : numeric
  placed_from_cart_id : uuid <<FK, nullable>>
  order_number : text <<UQ>>
}

entity "order_items" as order_items {
  * order_id : uuid <<PK, FK>>
  * order_item_id : int <<PK>>
  --
  listing_id : uuid <<FK>>
  product_id : uuid <<FK>>
  seller_id : uuid <<FK>>
  quantity : int
  unit_price : numeric
  freight_value : numeric
  shipping_limit_date : timestamp <<nullable>>
}

entity "order_payments" as order_payments {
  * order_id : uuid <<PK, FK>>
  * payment_sequential : int <<PK>>
  --
  payment_type : text
  payment_installments : int
  payment_value : numeric
  payment_status : text
  external_payment_reference : text <<nullable>>
  paid_at : timestamp <<nullable>>
}

entity "order_reviews" as order_reviews {
  * review_id : uuid <<PK>>
  --
  order_id : uuid <<FK>>
  review_score : int
  review_comment_title : text <<nullable>>
  review_comment_message : text <<nullable>>
  review_creation_date : timestamp
  review_answer_timestamp : timestamp <<nullable>>
}

entity "shipments" as shipments {
  * shipment_id : uuid <<PK>>
  --
  order_id : uuid <<FK>>
  seller_id : uuid <<FK>>
  carrier_name : text
  tracking_number : text
  shipment_status : text
  shipped_at : timestamp <<nullable>>
  delivered_at : timestamp <<nullable>>
  returned_at : timestamp <<nullable>>
  created_at : timestamp
  updated_at : timestamp
}


