'  order_id : uuid <<FK>>
'  amount : numeric
'  refund_status : text
'  external_refund_reference : text <<nullable>>
'  processed_at : timestamp <<nullable>>
'}

entity "notifications" as notifications {
  * notification_id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  order_id : uuid <<FK, nullable>>
  notification_type : text
  title : text
  body : text
  created_at : timestamp
  read_at : timestamp <<nullable>>
}

' =========================
' ADMIN / MONITORING
' =========================

entity "system_incidents" as system_incidents {
  * incident_id : uuid <<PK>>
  --
  incident_type : text
  severity : text
  status : text
  component_name : text
  message : text
  created_at : timestamp
  resolved_at : timestamp <<nullable>>
}

entity "audit_logs" as audit_logs {
  * audit_log_id : uuid <<PK>>
  --
  actor_user_id : uuid <<FK, nullable>>
  actor_ip_address : inet <<nullable>>
  action_type : text
  target_entity_type : text
  target_entity_id : text
  outcome : text
  details : text
  created_at : timestamp
}

' =========================
' RELATIONSHIPS
' =========================

user_accounts ||--o| customers : has
user_accounts ||--o| sellers : has
user_accounts ||--o| admins : has
user_accounts ||--o{ user_sessions : starts
user_accounts ||--o{ user_blocks : may_be_blocked
admins ||--o{ user_blocks : applies

sellers ||--o{ seller_verification_requests : submits
admins ||--o{ seller_verification_requests : reviews

addresses ||--o{ customers : default_address
addresses ||--o{ sellers : default_address

product_categories ||--o{ products : classifies
products ||--o{ product_listings : listed_as
sellers ||--o{ product_listings : owns

user_accounts ||--o{ shopping_carts : owns
user_sessions ||--o{ shopping_carts : guest_session
shopping_carts ||--o{ cart_items : contains
product_listings ||--o{ cart_items : referenced_by

customers ||--o{ orders : places
addresses ||--o{ orders : ship_to
shopping_carts ||--o{ orders : converts_to

orders ||--o{ order_items : contains
product_listings ||--o{ order_items : sold_as
products ||--o{ order_items : snapshot_product
sellers ||--o{ order_items : fulfilled_by

orders ||--o{ order_payments : paid_by
orders ||--o{ order_reviews : reviewed_by
orders ||--o{ shipments : shipped_in
sellers ||--o{ shipments : ships

'orders ||--o| order_cancellations : may_have
'order_cancellations ||--o{ refunds : triggers

orders ||--o{ notifications : generates
user_accounts ||--o{ notifications : receives
user_accounts ||--o{ audit_logs : acts_in

@enduml