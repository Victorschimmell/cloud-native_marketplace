{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=marketplace;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "OlistImport": {
    "Enabled": false,
    "DatasetRootPath": ".data/olist"
  },
  "LogFiles": {
    "DirectoryPath": "../../logs/backend"
  },
  "AdminUser": {
    "Email": "admin@example.com",
    "Password": ""
  },
  "SellerUser": {
    "Email": "seller@example.com",
    "Password": "seller1234",
    "BusinessName": "Demo Shop",
    "RegistrationNumber": "Demo Code 1234",
    "PayoutInformation": "IBAN"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}